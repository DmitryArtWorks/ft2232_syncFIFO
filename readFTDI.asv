iterRead = 1e7;
byteNum = 2;

distL = single.empty;
distV = single.empty;
% for j=1:4
    f_ID = fopen("test.bin", 'rb', 'ieee-le'); %C:\Users\dmitr\Desktop\USBSniffExport
    % fseek(f_ID, 20e3, "bof");
    data = fread(f_ID, 0.6e6, "ubit16");
    % plot(data)
    % pause
    i = 1;
    % system(".\main_file.exe")
    while true
        
        data = fread(f_ID, [2, iterRead], "ubit8=>single");
        disp(['loaded value: ' num2str(data(byteNum, 1))])
        disp(' ')
        % if i == 1
        %     i = i + 1;
        %     continue
        % end
        % 
        if isempty(data)
            break
        end
    
        % offs = 0;
        % len = 1e6;
        
        sawLen = length(data(byteNum,:));
        
        if i == 1
            sawS = zeros(sawLen, 1);
            sawS(1) = data(byteNum,1);
        end
        for r=2:sawLen
            sawS(r) = sawS(r-1) + 1;
            if (sawS(r) == 2^(8*byteNum))
                sawS(r) = 0;
            end
        end
        % d2plt = data(offs+1:end);
           
        dd2plt = diff(data(byteNum,:));
        indList = find(dd2plt ~= 1 & dd2plt ~= -255 & dd2plt ~= 0);
        % indList = find(dd2plt == -27 | dd2plt == -23 | dd2plt == -19 | dd2plt == -15);
        indListL = length(indList);
        valuesList = unique(dd2plt);
    
        IterInd = repelem(i, length(indList)).';
        distL = cat(1, distL, [indList.' IterInd] ); 
        distLL = length(distL(:,1));
        distV = unique(distL(:,1));
        % ind = 2; 
        
        % len = 1e6;
        len = length(data(byteNum,:));
        % offset = 8.5e6;
        % plot(1:len, data(byteNum, end-len-offset+1:end-offset), 1:len, sawS(end-len-offset+1:end-offset))
        % plot(1:len, data(byteNum, 1:len), 1:len, sawS(1:len))
        % pause

        if ~isempty(indList) 
            disp(length(indList))
            for j=15:length(indList)
                tmpV1 = data(byteNum,indList(j)-150:indList(j)+150);
                tmpV2 = sawS(indList(j)-150:indList(j)+150);
                plot(1:length(tmpV1), tmpV1, 1:length(tmpV2), tmpV2)
                pause
            end
        end
        i = i + 1;
        % pause
        % end
        sawS(1) = sawS(end) + 1;
        if sawS(1) == 65536
            sawS(1) = 0;
        end

        disp(['extrapolated: ' num2str(sawS(1))])
        
        if length(data(byteNum,:)) < iterRead
            break
        end
    end
    % disp(j)
        % plot(data)
        fclose(f_ID);
% end